x-4 ui-py-2 ui-text-start ui-text-[14px] ui-font-bold ui-leading-[1.4] ui-tracking-[0.08em] md:ui-min-w-72 ui-w-[30%]\">コース内容</th><td class=\"ui-border ui-border-[#D9D9D9] ui-whitespace-pre-line md:ui-px-6 ui-px-6 ui-py-2 ui-text-[14px] ui-leading-[1.4] ui-tracking-[0.08em] ui-w-[70%]\">15分＋食事管理10分／月4〜8回／1ヶ月</td></tr><tr><th class=\"ui-border ui-border-[#D9D9D9] ui-whitespace-nowrap ui-bg-[#EFEFEF] md:ui-px-6 ui-px-4 ui-py-2 ui-text-start ui-text-[14px] ui-font-bold ui-leading-[1.4] ui-tracking-[0.08em] md:ui-min-w-72 ui-w-[30%]\">形式</th><td class=\"ui-border ui-border-[#D9D9D9] ui-whitespace-pre-line md:ui-px-6 ui-px-6 ui-py-2 ui-text-[14px] ui-leading-[1.4] ui-tracking-[0.08em] ui-w-[70%]\">マンツーマン指導／グループレッスン・ペアレッスン可</td></tr></tbody></table></div></div><div class=\"ui-my-[16px] md:ui-mt-[32px]\" data-orizm-block-id=\"b55xKW0w7WBw\" data-orizm-block-type=\"Heading\"><h4 id=\"利用者の口コミ・体験談\" class=\"ui-leading-[1.4] ui-tracking-[0.08em] [counter-set:recommended-list] ui-relative ui-pb-[2px] ui-pl-[16px] ui-text-[#333333] ui-font-bold ui-text-[14px] md:ui-text-[18px]\"><div class=\"ui-absolute ui-left-0 ui-top-0 ui-bottom-0 ui-w-[4px] ui-rounded-l-[2px]\" style=\"background:linear-gradient(180deg, #008BD6 0%, #1970FC 100%)\"></div><span data-orizm-text-property=\"children\">利用者の口コミ・体験談</span></h4></div><div class=\"\" data-orizm-block-id=\"CiYpsN4aWNAH\" data-orizm-block-type=\"Text\"><div class=\"ui-text-[14px] ui-leading-[1.8] ui-tracking-[0.08em] ui-text-[#333333] ui-whitespace-pre-line [overflow-wrap:anywhere] [&amp;_u]:ui-underline [&amp;_u]:ui-decoration-[#FFD00033] [&amp;_u]:ui-decoration-solid [&amp;_u]:ui-decoration-[0.8em] [&amp;_u]:ui-underline-offset-[-0.25em] [&amp;_u]:[text-decoration-skip-ink:none] [&amp;_u]:selection:ui-underline [&amp;_u]:selection:ui-decoration-[#FFD00033] [&amp;_u]:selection:ui-decoration-solid [&amp;_u]:selection:ui-decoration-[0.8em] [&amp;_u]:selection:ui-underline-offset-[-0.25em] [&amp;_u]:selection:[text-decoration-skip-ink:none]\"><p style=\"text-align: left\">★★★★★ 5.0 一年間、週一で通い目標体重まで減量することができました。体重−9kg、体脂肪率−9%で身体が軽く感じられるようになりました。目標達成に向けてトレーニングを支えてくれたトレーナーの方々に感謝しています。<br><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"best-fit-link\" href=\"https://maps.app.goo.gl/aR2LfjGPNJoJ7rEE8\">https://maps.app.goo.gl/aR2LfjGPNJoJ7rEE8</a><br><br>★★★★★ 5.0<br>コロナ太りから数年、流石にやばいと思いダイエットを決意！近くでジムを探ししてたらエクササイズコーチに出会いました。 マンツーマンで食事指導からトレーニング何から何までアドバイスをくれます。 目標達成まで地道に頑張っていきます！！！<br><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"best-fit-link\" href=\"https://maps.app.goo.gl/uQP7ZkiRLiuh7dUZA\">https://maps.app.goo.gl/uQP7ZkiRLiuh7dUZA</a><br><br>★★★★★ 5.0<br>一年間で目標達成出来ました。 8kgの減量と体脂肪15%切ることが出来ました。<br><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"best-fit-link\" href=\"https://maps.app.goo.gl/i1pCKPtBFaiURgC16\">https://maps.app.goo.gl/i1pCKPtBFaiURgC16</a> </p></div></div></div></div></div>"}, "store:stores": {"id": "dEjzNPyw0MuMsM0j", "updatedAt": "2026-02-08T02:13:26.998Z", "createdAt": "2025-12-25T11:17:15.548Z", "group": null, "_draft": null, "_published": true, "publishedAt": "2025-12-25T11:17:15.042Z", "scheduledPublishAt": null, "scheduledUnpublishAt": null, "brandId": "VjFqZgUBcCpsTpWc", "slug": "tokihawasada", "name": "トキハわさだタウン店", "basicInformation": null, "trialPlan1TrainingTime": "30", "trialPlan1CounselingTime": "30", "trialPlan1Price": "0", "trialPlan2CounselingTime": "30", "trialPlan2Price": "0", "trialDiscountInfo": "", "trialPlanSupplement": "カウンセリング後、実際のトレーニングを体験いただけます。", "trialTrainingRequiredItems": "無し", "addressPrefecture": null, "addressMunicipalities": null, "addressStreet": null, "address": "大分県大分市大字玉沢755-1　トキハわさだタウン2街区3階", "prefectureId": "KwxyAWQ0lbWQY7r9", "cityId": "yImojg01rPuBYlyI", "wardId": null, "telephoneNumber": null, "access": "賀来駅から車で12分", "openingHours": "平日 10:00～20:00（最終受付19:30）\n土日祝 10:00～20:00（最終受付19:30）", "url": null, "affiliateLink": "", "affiliateLinkCvTag": "", "catchcopy": "1回たった20分。マシン主導の安全・効率的トレーニン